<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.y1sync.automount</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SHELL__</string>
    <string>__REPO__/scripts/on-mount.sh</string>
  </array>
  <!-- Se dispara al montarse CUALQUIER volumen; on-mount.sh filtra. -->
  <key>StartOnMount</key>     <true/>
  <key>RunAtLoad</key>        <false/>
  <key>StandardOutPath</key>  <string>__HOME__/Library/Logs/y1sync.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/y1sync.log</string>
</dict>
</plist>
