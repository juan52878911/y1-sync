#!/system/bin/sh
# Lanzador. Debe devolver el control YA: 99Y1ButtonScript tiene un bucle
# infinito, y run-parts los ejecuta en orden, asi que bloquear aqui dejaria
# al aparato sin las combinaciones de botones.
#
# Con prioridad baja (nice 19) para no competir con la reproduccion ni con
# el resto del arranque.
[ -x /system/etc/y1radio.sh ] || exit 0
[ -f /sdcard/y1radio.off ] && exit 0
setsid nice -n 19 /system/etc/y1radio.sh >/dev/null 2>&1 &
exit 0
