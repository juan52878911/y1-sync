#!/bin/bash
# Lanzador que filtra el ruido de un hashlib incompleto.
#
# Si Python fue compilado contra una OpenSSL sin blake2 (habitual en pyenv),
# hashlib vuelca dos tracebacks al importarse. Son inofensivos pero tapan la
# salida. El arreglo de fondo es recompilar Python; ver README.
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"
exec python3 -u -m y1sync "$@" 2> >(grep -vE "blake2|hashlib\.py|__get_|globals\(\)|unsupported hash|~~~|\^\^\^|^Traceback|^ERROR:root:code|^ *File \"|^ *return |^ *raise ValueError" >&2)
